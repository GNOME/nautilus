using Gtk 4.0;
using Adw 1;

template $NautilusAppChooser: Adw.Dialog {
  content-width: 400;
  content-height: 570;

  styles [
    "view",
  ]

  child: Adw.ToolbarView toolbar_view {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: _("Open With");
        subtitle: bind template.target-description;
      };
    }

    [top]
    Adw.Clamp {
      maximum-size: 240;
      margin-bottom: 12;

      styles [
        "toolbar",
      ]

      SearchEntry search_entry {
        activates-default: true;
        placeholder-text: _("Search Apps");
        search-changed => $gtk_widget_grab_focus();

        styles [
          "rounded-entry",
        ]
      }
    }

    [bottom]
    ListBox set_default_list_box {
      selection-mode: none;

      Adw.SwitchRow set_default_row {}
    }
  };
}
