using Gtk 4.0;
using Adw 1;

template $NautilusAppChooser: Adw.Dialog {
  title: _("Open File");
  content-width: 420;
  content-height: 560;
  default-widget: ok_button;
  focus-widget: search_entry;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("_Cancel");
        use-underline: true;
        can-shrink: true;
        clicked => $adw_dialog_close(template);
      }

      [end]
      Button ok_button {
        label: _("_Open");
        use-underline: true;
        can-shrink: true;
        sensitive: false;
        activate => $open_cb(template);
        clicked => $open_cb(template);

        styles [
          "suggested-action",
        ]
      }
    }

    [top]
    Adw.Clamp {
      maximum-size: 360;

      styles [
        "toolbar",
      ]

      child: Box {
        margin-top: 6;
        orientation: vertical;
        spacing: 12;

        Box {
          halign: center;
          spacing: 12;

          Adw.Bin {
            styles [
              "circled-icon",
            ]

            Image icon {
              icon-name: bind template.generic-icon;
              icon-size: large;
              margin-bottom: 12;
              margin-top: 12;
              margin-start: 12;
              margin-end: 12;
              halign: center;
              valign: center;
            }
          }

          Box {
            orientation: vertical;
            valign: center;

            Label {
              label: bind template.target-description;
              lines: 2;
              ellipsize: middle;
              width-chars: 15;
              wrap: true;
              wrap-mode: word_char;
              xalign: 0.0;

              styles [
                "heading",
              ]
            }

            Label type_label {
              label: bind template.type-description;
              xalign: 0.0;

              styles [
                "dimmed",
                "caption",
              ]
            }
          }
        }

        SearchEntry search_entry {
          activates-default: true;
          placeholder-text: _("Search Apps");
          search-changed => $gtk_widget_grab_focus();

          styles [
            "rounded-entry",
          ]
        }
      };
    }

    content: Adw.Clamp {
      margin-top: 18;
      margin-bottom: 18;
      margin-start: 18;
      margin-end: 18;

      child: Box content_box {
        orientation: vertical;
        spacing: 12;
      };
    };

    [bottom]
    ListBox set_default_list_box {
      selection-mode: none;

      Adw.SwitchRow set_default_row {
        title: _("Always use for this file type");
        subtitle: bind template.type-description;
      }

      styles [
        "background",
      ]
    }
  };
}
