#: extensions/audio-video-properties/totem-properties-view.c:101
#, c-format
msgctxt "time"
msgid "%s %s"
msgstr "%s %s"

#. 0 seconds
#: extensions/audio-video-properties/totem-properties-view.c:111
msgid "0 seconds"
msgstr "0 секунди"

#: extensions/audio-video-properties/totem-properties-view.c:131 extensions/image-properties/nautilus-image-properties-model.c:224 src/nautilus-batch-rename-dialog.h:165 src/resources/ui/nautilus-batch-rename-dialog.blp:65
msgid "Title"
msgstr "Наслов"

