msgstr "Перегляд ґраткою"

#: data/org.gnome.Nautilus.metainfo.xml.in.in:80 src/nautilus-files-view.c:9340
msgid "List View"
msgstr "Перегляд списком"

#: data/org.gnome.Nautilus.metainfo.xml.in.in:84
#: src/nautilus-search-directory-file.c:216
#: src/nautilus-search-directory-file.c:255
msgid "Search"
msgstr "Пошук"

#: data/org.gnome.Nautilus.metainfo.xml.in.in:88
